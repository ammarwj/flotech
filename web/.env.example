# flo-event web (Next.js) environment template.
# Local dev: copy to .env.local. Production (Docker): copy to .env.production.

NEXT_PUBLIC_API_URL=https://api.floevent.id/api/v1
NEXT_PUBLIC_APP_URL=https://floevent.id

# Custom domain: dari mana proxy.ts membaca daftar domain aktif. Dibaca
# saat RUNTIME (tidak pernah sampai ke browser), jadi mengubahnya tidak perlu
# rebuild image — beda dari NEXT_PUBLIC_* di atas. Di Docker diisi
# http://api:8000/api/v1; kosong = ikut NEXT_PUBLIC_API_URL.
INTERNAL_API_URL=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
